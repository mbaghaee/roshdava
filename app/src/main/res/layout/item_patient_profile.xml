<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" style="@style/GrowthCard">
    <LinearLayout style="@style/GrowthCardBody">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/patient_name" style="@style/GrowthText.Section"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginBottom="0dp" android:textSize="18sp" />
            <ImageButton android:id="@+id/delete_profile_button"
                android:layout_width="48dp" android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="حذف کل سوابق این فرد"
                android:src="@drawable/ic_delete"
                android:tint="@color/growth_chart_outer_line" />
        </LinearLayout>
        <TextView android:id="@+id/profile_summary" style="@style/GrowthText.Muted" android:textSize="13sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/open_profile_button"
            style="@style/GrowthButton.Outlined" android:text="مشاهدهٔ پرونده و سنجش‌ها" />
        <com.google.android.material.button.MaterialButton android:id="@+id/follow_up_button"
            style="@style/GrowthButton" android:text="سنجش جدید برای همین فرد" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
