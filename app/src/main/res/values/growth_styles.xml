<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="NutritionCalorieWheel">
        <item name="android:textColorPrimary">@color/growth_ink</item>
        <item name="android:editTextColor">@color/growth_ink</item>
    </style>
    <style name="GrowthScreen">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layoutDirection">rtl</item>
    </style>
    <style name="GrowthText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/vazirmatn_regular</item>
        <item name="android:textColor">@color/growth_ink</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textDirection">rtl</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:gravity">start</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="GrowthText.Title" parent="GrowthText">
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">@font/vazirmatn_bold</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
    <style name="GrowthText.Section" parent="GrowthText">
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">@font/vazirmatn_bold</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>
    <style name="GrowthText.Muted" parent="GrowthText">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/growth_muted</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
    <style name="GrowthCard" parent="Widget.Material3.CardView.Outlined">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/growth_border</item>
        <item name="cardBackgroundColor">@color/white</item>
    </style>
    <style name="GrowthCardBody" parent="GrowthScreen">
        <item name="android:padding">20dp</item>
    </style>
    <style name="GrowthButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/vazirmatn_regular</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">16dp</item>
    </style>
    <style name="GrowthButton.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/vazirmatn_regular</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">16dp</item>
    </style>
    <style name="GrowthNavigationButton" parent="GrowthButton.Outlined">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:layout_marginBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAlignment">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">2</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="GrowthField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>
    <style name="GrowthInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/vazirmatn_regular</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/growth_ink</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:padding">14dp</item>
        <item name="android:saveEnabled">false</item>
    </style>
    <style name="GrowthCheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:fontFamily">@font/vazirmatn_regular</item>
        <item name="android:textDirection">rtl</item>
        <item name="android:saveEnabled">false</item>
    </style>
</resources>
