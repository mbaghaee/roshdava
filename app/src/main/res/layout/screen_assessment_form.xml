<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/GrowthScreen">
    <!--   <TextView style="@style/GrowthText.Muted" android:text="مائده بقایی متخصص تغذیه" />
        <TextView style="@style/GrowthText.Muted" android:textSize="13sp"
           android:layout_marginBottom="18dp" android:text="از نخستین روز تولد تا بزرگسالی؛ با مرجع متناسب با سن." /> -->
    <TextView android:id="@+id/profile_notice" style="@style/GrowthText.Muted"
        android:textColor="@color/growth_teal" android:visibility="gone"
        android:text=" برای فرد جدید «ارزیابی تازه» را بزنید." />
    <com.google.android.material.card.MaterialCardView style="@style/GrowthCard">
        <LinearLayout style="@style/GrowthCardBody">
            <TextView style="@style/GrowthText.Section" android:text="۰۱    مشخصات فرد" />
            <com.google.android.material.textfield.TextInputLayout style="@style/GrowthField"
                android:hint="نام یا شناسه فرد (اختیاری)">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/patient_name"
                    style="@style/GrowthInput" android:inputType="textCapWords" android:textDirection="rtl" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView style="@style/GrowthText.Muted" android:text="جنسیت مرجع رشد" />
            <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/gender_group"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" android:saveEnabled="false"
                app:singleSelection="true" app:selectionRequired="true">
                <com.google.android.material.button.MaterialButton android:id="@+id/girl_button"
                    style="@style/GrowthNavigationButton" android:text="دختر / زن" android:saveEnabled="false" />
                <com.google.android.material.button.MaterialButton android:id="@+id/boy_button"
                    style="@style/GrowthNavigationButton" android:text="پسر / مرد" android:saveEnabled="false" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
            <com.google.android.material.button.MaterialButton android:id="@+id/birth_button"
                style="@style/GrowthButton.Outlined" android:text="انتخاب تاریخ تولد · شمسی" />
            <com.google.android.material.button.MaterialButton android:id="@+id/visit_button"
                style="@style/GrowthButton.Outlined" android:text="تاریخ سنجش · شمسی" />
            <TextView style="@style/GrowthText.Muted" android:textSize="11sp"
                android:text="سن از فاصلهٔ واقعی تولد تا روز سنجش محاسبه می‌شود." />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView style="@style/GrowthCard">
        <LinearLayout style="@style/GrowthCardBody">
            <TextView style="@style/GrowthText.Section" android:text="۰۲    اندازه‌گیری‌ها" />
            <com.google.android.material.textfield.TextInputLayout style="@style/GrowthField" android:hint="وزن · کیلوگرم">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/weight_input"
                    style="@style/GrowthInput" android:inputType="numberDecimal" android:textDirection="ltr" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/GrowthField" android:hint="قد یا طول بدن · سانتی‌متر">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/height_input"
                    style="@style/GrowthInput" android:inputType="numberDecimal" android:textDirection="ltr" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/lying_checkbox"
                style="@style/GrowthCheckBox" android:text="قد به صورت خوابیده اندازه‌گیری شده" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/head_box"
                style="@style/GrowthField" android:hint="دور سر · سانتی‌متر (اختیاری)">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/head_input"
                    style="@style/GrowthInput" android:inputType="numberDecimal" android:textDirection="ltr" />
            </com.google.android.material.textfield.TextInputLayout>
            <LinearLayout android:id="@+id/waist_section" style="@style/GrowthScreen" android:visibility="gone">
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/waist_box"
                    style="@style/GrowthField" android:hint="دور کمر · سانتی‌متر (اختیاری)">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/waist_input"
                        style="@style/GrowthInput" android:inputType="numberDecimal" android:textDirection="ltr" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/waist_guide_button"
                    style="@style/GrowthButton.Outlined" android:text="راهنمای اندازه‌گیری دور کمر" />
            </LinearLayout>
            <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/premature_checkbox"
                style="@style/GrowthCheckBox" android:text="تولد زودرس / نوزاد نارس" />
            <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/pregnant_checkbox"
                style="@style/GrowthCheckBox" android:text="فرد باردار است" />
            <include android:id="@+id/pregnancy_form" layout="@layout/form_pregnancy" />
            <TextView style="@style/GrowthText.Muted" android:text="با لباس سبک، ترازوی مناسب و روش یکسان اندازه‌گیری کنید." />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.button.MaterialButton android:id="@+id/calculate_button"
        style="@style/GrowthButton" android:minHeight="60dp" android:text="مشاهدهٔ ارزیابی رشد  ←" />
    <com.google.android.material.button.MaterialButton android:id="@+id/fresh_button"
        style="@style/GrowthButton.Outlined" android:text="ارزیابی تازه؛ پاک‌کردن فرم" />
    <TextView style="@style/GrowthText.Muted" android:textSize="11sp"
        android:text="اطلاعات روی همین دستگاه ذخیره می‌شود. ارزیابی، ابزار غربالگری است و جای معاینه را نمی‌گیرد." />
</LinearLayout>
