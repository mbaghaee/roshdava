<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/app_root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical"
    android:layoutDirection="rtl" android:background="@color/growth_background"
    tools:context=".MainActivity">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:paddingStart="22dp" android:paddingEnd="22dp"
        android:paddingTop="12dp" android:paddingBottom="6dp">
        <TextView style="@style/GrowthText" android:layout_width="44dp" android:layout_height="48dp"
            android:gravity="center" android:text="◉" android:textSize="30sp"
            android:textColor="@color/growth_teal" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView style="@style/GrowthText.Title" android:text="@string/app_name"
                android:textSize="22sp" android:layout_marginBottom="0dp" />
            <TextView style="@style/GrowthText.Muted" android:text="مائده بقایی متخصص تغذیه"
                android:textSize="11sp" android:layout_marginBottom="0dp" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/about_button"
            style="@style/GrowthButton.Outlined" android:layout_width="86dp"
            android:text="درباره" android:layout_marginBottom="0dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:baselineAligned="false" android:gravity="center_vertical"
        android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingBottom="6dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/form_tab"
            style="@style/GrowthNavigationButton" android:text="فرم ارزیابی" />
        <com.google.android.material.button.MaterialButton android:id="@+id/history_tab"
            style="@style/GrowthNavigationButton" android:text="سوابق سنجش" />
        <com.google.android.material.button.MaterialButton android:id="@+id/backup_tab"
            style="@style/GrowthNavigationButton" android:text="پشتیبان" />
    </LinearLayout>
    <ScrollView android:id="@+id/page_scroll" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true"
        android:clipToPadding="false" android:saveEnabled="false">
        <LinearLayout android:id="@+id/page_body" style="@style/GrowthScreen"
            android:paddingStart="18dp" android:paddingEnd="18dp"
            android:paddingTop="10dp" android:paddingBottom="28dp" />
    </ScrollView>
</LinearLayout>
